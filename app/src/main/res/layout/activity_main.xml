<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_disconnected"
            android:textColor="@color/accent_red"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConnect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/btn_primary"
            android:text="@string/btn_connect"
            android:textColor="@color/text_white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txtGear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="N"
            android:textColor="@color/accent_green"
            android:textSize="120sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="72sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="KM / H"
            android:textColor="@color/text_gray"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="16dp"
        android:layout_weight="1"
        android:alignmentMode="alignBounds"
        android:columnCount="3"
        android:rowCount="4"
        android:useDefaultMargins="true">

        <!-- ROW 1 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="RPM" />

            <TextView
                android:id="@+id/txtRpm"
                style="@style/DashboardValue"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="TEMP" />

            <TextView
                android:id="@+id/txtTemp"
                style="@style/DashboardValue"
                android:text="0 °C" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="THROTTLE" />

            <TextView
                android:id="@+id/txtThrottle"
                style="@style/DashboardValue"
                android:text="0 %" />
        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="MAP (kPa)" />

            <TextView
                android:id="@+id/txtMap"
                style="@style/DashboardValue"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="IAT" />

            <TextView
                android:id="@+id/txtIat"
                style="@style/DashboardValue"
                android:text="0 °C" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="LOAD" />

            <TextView
                android:id="@+id/txtLoad"
                style="@style/DashboardValue"
                android:text="0 %" />
        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="O2 VOLT" />

            <TextView
                android:id="@+id/txtO2"
                style="@style/DashboardValue"
                android:text="0.0 V" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="BATT VOLT" />

            <TextView
                android:id="@+id/txtBatt"
                style="@style/DashboardValue"
                android:text="0.0 V" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="TIMING" />

            <TextView
                android:id="@+id/txtTiming"
                style="@style/DashboardValue"
                android:text="0°" />
        </LinearLayout>

        <!-- ROW 4 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="RUNTIME" />

            <TextView
                android:id="@+id/txtRuntime"
                style="@style/DashboardValue"
                android:text="0 s" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="MIL DIST" />

            <TextView
                android:id="@+id/txtMilDist"
                style="@style/DashboardValue"
                android:text="0 km" />
        </LinearLayout>

    </GridLayout>

    <Button
        android:id="@+id/btnDtc"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:backgroundTint="@color/btn_danger"
        android:text="@string/btn_dtc"
        android:textColor="@color/text_white"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnDtcDictionary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/card_bg"
        android:text="Show All DTC Descriptions"
        android:textColor="@color/text_white"
        android:textStyle="bold" />

</LinearLayout>
