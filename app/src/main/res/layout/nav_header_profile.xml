<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/card_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardProfileCircle"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/accent_green"
        app:cardCornerRadius="36dp"
        app:cardElevation="6dp"
        app:strokeColor="@color/text_white"
        app:strokeWidth="2dp">

        <ImageView
            android:id="@+id/imgHeaderProfileThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:src="@drawable/ic_bike_blueprint"
            app:tint="@color/black_bg" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/txtHeaderProfileName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Royal Enfield Classic 350"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtHeaderProfileSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Tap to Manage Profiles"
        android:textColor="@color/text_gray"
        android:textSize="12sp" />

</LinearLayout>
