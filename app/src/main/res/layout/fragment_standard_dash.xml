<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg"
    android:fillViewport="true"
    android:padding="16dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignBounds"
        android:columnCount="3"
        android:useDefaultMargins="true">

        <!-- ROW 1 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="RPM" />

            <TextView
                android:id="@+id/txtRpm"
                style="@style/DashboardValue"
                android:text="0" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="SPEED" />

            <TextView
                android:id="@+id/txtSpeed"
                style="@style/DashboardValue"
                android:text="0 km/h" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="TEMP" />

            <TextView
                android:id="@+id/txtTemp"
                style="@style/DashboardValue"
                android:text="0 °C" />
        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="THROTTLE" />

            <TextView
                android:id="@+id/txtThrottle"
                style="@style/DashboardValue"
                android:text="0 %" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="MAP" />

            <TextView
                android:id="@+id/txtMap"
                style="@style/DashboardValue"
                android:text="0 kPa" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="IAT" />

            <TextView
                android:id="@+id/txtIat"
                style="@style/DashboardValue"
                android:text="0 °C" />
        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="LOAD" />

            <TextView
                android:id="@+id/txtLoad"
                style="@style/DashboardValue"
                android:text="0 %" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="O2 VOLT" />

            <TextView
                android:id="@+id/txtO2"
                style="@style/DashboardValue"
                android:text="0.0 V" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="BATT VOLT" />

            <TextView
                android:id="@+id/txtBatt"
                style="@style/DashboardValue"
                android:text="0.0 V" />
        </LinearLayout>

        <!-- ROW 4 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="TIMING" />

            <TextView
                android:id="@+id/txtTiming"
                style="@style/DashboardValue"
                android:text="0°" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="RUNTIME" />

            <TextView
                android:id="@+id/txtRuntime"
                style="@style/DashboardValue"
                android:text="0 s" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="MIL DIST" />

            <TextView
                android:id="@+id/txtMilDist"
                style="@style/DashboardValue"
                android:text="0 km" />
        </LinearLayout>

    </GridLayout>
</ScrollView>
