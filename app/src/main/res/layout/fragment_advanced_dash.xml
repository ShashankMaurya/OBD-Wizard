<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg"
    android:fillViewport="true"
    android:padding="16dp">

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignBounds"
        android:columnCount="3"
        android:useDefaultMargins="true">

        <!-- ROW 1 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="MAP" />

            <TextView
                android:id="@+id/txtMap"
                style="@style/DashboardValue"
                android:text="0 kPa" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="IAT" />

            <TextView
                android:id="@+id/txtIat"
                style="@style/DashboardValue"
                android:text="0 °C" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="LOAD" />

            <TextView
                android:id="@+id/txtLoad"
                style="@style/DashboardValue"
                android:text="0 %" />
        </LinearLayout>

        <!-- ROW 2 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="O2 VOLT" />

            <TextView
                android:id="@+id/txtO2"
                style="@style/DashboardValue"
                android:text="0.00 V" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="TIMING" />

            <TextView
                android:id="@+id/txtTiming"
                style="@style/DashboardValue"
                android:text="0.0°" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="MIL DIST" />

            <TextView
                android:id="@+id/txtMilDist"
                style="@style/DashboardValue"
                android:text="0 km" />
        </LinearLayout>

        <!-- ROW 3 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="AVG ECON" />

            <TextView
                android:id="@+id/txtAvgEcon"
                style="@style/DashboardValue"
                android:text="0.0 km/L" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="FUEL USED" />

            <TextView
                android:id="@+id/txtFuelUsed"
                style="@style/DashboardValue"
                android:text="0.00 L" />
        </LinearLayout>

        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="MIXTURE" />

            <TextView
                android:id="@+id/txtMixture"
                style="@style/DashboardValue"
                android:text="-" />
        </LinearLayout>

        <!-- ROW 4 -->
        <LinearLayout
            style="@style/DashboardCard"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1">

            <TextView
                style="@style/DashboardLabel"
                android:text="SHIFT" />

            <TextView
                android:id="@+id/txtShift"
                style="@style/DashboardValue"
                android:text="-" />
        </LinearLayout>

    </GridLayout>
</ScrollView>
