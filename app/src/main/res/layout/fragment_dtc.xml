<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="56dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDtcScan"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:backgroundTint="@color/btn_danger"
            app:icon="@drawable/ic_check_engine"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/text_white"
            android:text="Scan &amp; Clear DTCs"
            android:textColor="@color/text_white"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:id="@+id/progressDtc"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:indeterminate="true"
                android:indeterminateTint="#FFFFFF" />

            <TextView
                android:id="@+id/txtLoading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="SCANNING ECU..."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDtcDictionary"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:backgroundTint="@color/card_bg"
        app:icon="@drawable/ic_book_dictionary"
        app:iconGravity="textStart"
        app:iconPadding="12dp"
        app:iconTint="@color/text_white"
        android:text="Show All DTC Descriptions"
        android:textColor="@color/text_white"
        android:textStyle="bold" />

</LinearLayout>
