<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0C0F14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRIP SUMMARY"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTripTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="May 24, 2024 • 14:20"
            android:textColor="#8A99AD"
            android:textSize="14sp" />

        <!-- Primary Stats Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="2"
            android:useDefaultMargins="true">

            <LinearLayout
                style="@style/DashboardCard"
                android:layout_width="0dp"
                android:layout_columnWeight="1">

                <TextView
                    style="@style/DashboardLabel"
                    android:text="DISTANCE" />

                <TextView
                    android:id="@+id/txtSumDistance"
                    style="@style/DashboardValue"
                    android:text="0.0 km" />
            </LinearLayout>

            <LinearLayout
                style="@style/DashboardCard"
                android:layout_width="0dp"
                android:layout_columnWeight="1">

                <TextView
                    style="@style/DashboardLabel"
                    android:text="DURATION" />

                <TextView
                    android:id="@+id/txtSumDuration"
                    style="@style/DashboardValue"
                    android:text="00:00" />
            </LinearLayout>

            <LinearLayout
                style="@style/DashboardCard"
                android:layout_width="0dp"
                android:layout_columnWeight="1">

                <TextView
                    style="@style/DashboardLabel"
                    android:text="AVG SPEED" />

                <TextView
                    android:id="@+id/txtSumAvgSpeed"
                    style="@style/DashboardValue"
                    android:text="0 km/h" />
            </LinearLayout>

            <LinearLayout
                style="@style/DashboardCard"
                android:layout_width="0dp"
                android:layout_columnWeight="1">

                <TextView
                    style="@style/DashboardLabel"
                    android:text="MAX SPEED" />

                <TextView
                    android:id="@+id/txtSumMaxSpeed"
                    style="@style/DashboardValue"
                    android:text="0 km/h" />
            </LinearLayout>
        </GridLayout>

        <!-- Performance Timing Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PERFORMANCE TIMERS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/DashboardCard"
                    android:layout_width="120dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        style="@style/DashboardLabel"
                        android:text="0-40 KM/H" />

                    <TextView
                        android:id="@+id/txtSum0to40"
                        style="@style/DashboardValue"
                        android:text="- s" />
                </LinearLayout>

                <LinearLayout
                    style="@style/DashboardCard"
                    android:layout_width="120dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        style="@style/DashboardLabel"
                        android:text="0-60 KM/H" />

                    <TextView
                        android:id="@+id/txtSum0to60"
                        style="@style/DashboardValue"
                        android:text="- s" />
                </LinearLayout>

                <LinearLayout
                    style="@style/DashboardCard"
                    android:layout_width="120dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        style="@style/DashboardLabel"
                        android:text="0-80 KM/H" />

                    <TextView
                        android:id="@+id/txtSum0to80"
                        style="@style/DashboardValue"
                        android:text="- s" />
                </LinearLayout>

                <LinearLayout
                    style="@style/DashboardCard"
                    android:layout_width="120dp">

                    <TextView
                        style="@style/DashboardLabel"
                        android:text="0-100 KM/H" />

                    <TextView
                        android:id="@+id/txtSum0to100"
                        style="@style/DashboardValue"
                        android:text="- s" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Charts Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="TELEMETRY CHARTS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartSpeed"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card" />

        <com.github.mikephil.charting.charts.LineChart
            android:id="@+id/chartRpm"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_dashboard_card" />

        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="32dp"
            android:backgroundTint="#00E5FF"
            android:text="CLOSE"
            android:textColor="#000000"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
